<div class="mx-auto max-w-md px-4 py-10">
  <h1 class="text-2xl font-semibold text-white">Sign in</h1>

  <%= form_with url: session_path, class: "mt-6 space-y-4" do |f| %>
    <% if alert = flash[:alert] %>
      <p class="text-sm text-rose-300"><%= alert %></p>
    <% end %>

    <% if notice = flash[:notice] %>
      <p class="text-sm text-emerald-300"><%= notice %></p>
    <% end %>

    <div>
      <%= f.label :email, class: "block text-sm text-slate-300" %>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "username", value: params[:email],
            class: "mt-1 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-white" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm text-slate-300" %>
      <%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
            class: "mt-1 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-white" %>
    </div>

    <%= f.submit "Sign in", class: "w-full cursor-pointer rounded-lg bg-emerald-600 py-2.5 font-medium text-white hover:bg-emerald-500" %>

    <p class="text-center text-sm text-slate-400">
      <%= link_to "Forgot password?", new_password_path, class: "text-emerald-400 hover:text-emerald-300" %>
    </p>
  <% end %>

  <p class="mt-6 text-center text-sm text-slate-400">
    No account?
    <%= link_to "Create account", new_registration_path, class: "text-emerald-400 hover:text-emerald-300" %>
  </p>
</div>
