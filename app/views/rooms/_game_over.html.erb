<% players = RoomPlayersQuery.for_room(room).to_a %>
<% winner = room.active_non_eliminated_players.first %>

<div class="space-y-6 text-center">
  <h2 class="text-2xl font-semibold text-white">Game over</h2>

  <% if winner %>
    <p class="text-lg text-emerald-300">Winner: <span class="font-semibold"><%= winner.user.username %></span></p>
  <% else %>
    <p class="text-slate-300">No winner recorded.</p>
  <% end %>

  <% if players.any? %>
    <div class="mx-auto max-w-md text-left">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Final scores</h3>
      <ul class="mt-3 divide-y divide-slate-800 rounded-xl border border-slate-800">
        <% players.each do |p| %>
          <% is_winner = winner && p.id == winner.id %>
          <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm <%= is_winner ? "bg-emerald-950/40 text-emerald-100" : "text-slate-200" %>">
            <span class="flex items-center gap-2">
              <%= p.user.username %>
              <% if is_winner %>
                <span class="text-xs font-medium text-emerald-400">winner</span>
              <% elsif p.eliminated? %>
                <span class="text-xs text-rose-300">eliminated</span>
              <% end %>
            </span>
            <span class="<%= is_winner ? "font-semibold text-emerald-200" : "text-slate-400" %>"><%= p.total_score %> pts</span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= link_to "Back to rooms", rooms_path, class: "inline-block rounded-lg border border-slate-600 px-4 py-2 text-white hover:bg-slate-800", data: { turbo_frame: "_top" } %>
</div>
