<% completed = room.rounds.status_completed.order(:number) %>
<% if completed.any? %>
  <section class="mt-8 rounded-2xl border border-slate-800 bg-slate-950/40 p-4">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Completed rounds</h2>
    <div class="mt-4 space-y-6">
      <% completed.each do |r| %>
        <article class="rounded-xl border border-slate-800 bg-slate-900/50 p-4">
          <h3 class="text-base font-medium text-white">Round <%= r.number %></h3>
          <% summary = r.scoring_summary.presence || {} %>
          <% entries = summary["entries"] || [] %>
          <% if entries.any? %>
            <ul class="mt-3 space-y-2 text-sm text-slate-300">
              <% entries.each do |e| %>
                <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-800/60 pb-2">
                  <span>
                    <%= e["username"] %>
                    <% if e["room_player_id"] == summary["winner_id"] %>
                      <span class="text-xs text-emerald-400">winner</span>
                    <% end %>
                  </span>
                  <span class="text-slate-400">
                    <%= e["points"] %> pts
                    <% if e["bonus_points"].to_i != 0 %>
                      (<%= e["bonus_points"] %> bonus)
                    <% end %>
                  </span>
                </li>
                <% hand = e["hand"] || r.final_hands[e["room_player_id"]] || [] %>
                <% if hand.present? && e["room_player_id"] != summary["winner_id"] %>
                  <li class="pb-2 text-xs text-slate-500">
                    Remaining: <%= hand.map { |c| card_short_label(c) }.join(", ") %>
                  </li>
                <% end %>
              <% end %>
            </ul>
          <% else %>
            <% r.score_entries.includes(room_player: :user).each do |se| %>
              <p class="mt-2 text-sm text-slate-400">
                <%= se.room_player.user.username %>: <%= se.points %> pts
              </p>
            <% end %>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
