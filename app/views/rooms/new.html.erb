<div class="mx-auto max-w-md px-4 py-10">
  <h1 class="text-2xl font-semibold text-white">New room</h1>
  <%= form_with model: Room.new, url: rooms_path, class: "mt-6 space-y-4" do |f| %>
    <div>
      <%= f.label :name, "Name (optional)", class: "block text-sm text-slate-300" %>
      <%= f.text_field :name, class: "mt-1 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-white" %>
    </div>
    <%= f.submit "Create", class: "w-full cursor-pointer rounded-lg bg-emerald-600 py-2.5 font-medium text-white hover:bg-emerald-500" %>
  <% end %>
</div>
