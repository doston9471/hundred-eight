<div class="space-y-6" data-controller="room-role" data-room-role-host-id-value="<%= room.host_id %>">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <p class="text-sm text-slate-400">Waiting for players (2–5).</p>
    </div>
    <div data-room-role-target="hostOnly" class="hidden flex flex-wrap gap-2">
      <%= button_to "Generate invite link", create_invite_room_path(room), method: :post, form: { data: { turbo_frame: "_top" } }, class: "rounded-lg border border-slate-600 px-3 py-2 text-sm text-white hover:bg-slate-800" %>
      <% if room.player_count_in_bounds? %>
        <%= button_to "Start game", start_room_path(room), method: :post, form: { data: { turbo_frame: "_top" } }, class: "rounded-lg bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-500" %>
      <% end %>
    </div>
  </div>

  <div>
    <h3 class="text-sm font-medium uppercase tracking-wide text-slate-400">Players</h3>
    <ul class="mt-3 divide-y divide-slate-800 rounded-xl border border-slate-800">
      <% RoomPlayersQuery.for_room(room).each do |rp| %>
        <li class="flex items-center justify-between px-4 py-3 text-slate-100">
          <span class="flex items-center gap-2">
            <%= rp.user.username %>
            <% if rp.user_id == room.host_id %><span class="text-xs text-amber-300">host</span><% end %>
          </span>
          <% if room.waiting? && rp.user_id != room.host_id %>
            <span data-room-role-target="hostOnly" class="hidden">
              <%= button_to "Remove", remove_player_room_path(room), params: { player_id: rp.id }, method: :post, data: { turbo_confirm: "Remove this player?" }, form: { data: { turbo_frame: "_top" } }, class: "text-xs text-rose-300 hover:underline" %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
