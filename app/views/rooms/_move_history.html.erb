<%# locals: (round:, chronological: false, show_time: true, limit: 200, compact: false) %>
<% plays = round_history_plays(round, chronological: chronological, limit: limit) %>
<% start_header = round_start_header(round) %>
<div class="<%= compact ? "" : "rounded-2xl border border-slate-800 bg-slate-950/50 p-4" %>">
  <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Move history</h3>
  <% if start_header.present? %>
    <p class="mt-3 rounded-lg border border-slate-700/80 bg-slate-900/80 px-3 py-2 text-sm font-medium text-amber-100">
      <%= start_header %>
    </p>
  <% end %>
  <% if plays.any? %>
    <ol class="mt-3 <%= compact ? "max-h-48" : "max-h-[28rem]" %> space-y-2 overflow-y-auto text-sm text-slate-300">
      <% plays.each do |cp| %>
        <li class="border-b border-slate-800/80 pb-2 last:border-0">
          <% if show_time %>
            <span class="text-slate-500"><%= time_ago_in_words(cp.created_at) %> ago</span>
          <% end %>
          <p class="<%= show_time ? "mt-0.5" : "" %>"><%= card_play_description(cp) %></p>
        </li>
      <% end %>
    </ol>
  <% elsif start_header.blank? %>
    <p class="mt-3 text-sm text-slate-500">No moves recorded.</p>
  <% end %>
</div>
