<div
  class="mx-auto max-w-5xl px-4 py-6"
  data-controller="room-channel"
  data-room-channel-room-id-value="<%= @room.id %>"
  data-room-page
  data-current-user-id="<%= current_user&.id %>"
>
  <%= turbo_stream_from RoomStreams.stream_name(@room) %>
  <%= render "rooms/presence_strip", room: @room %>
  <div id="room_flash"></div>

  <div class="mb-4">
    <h1 class="text-2xl font-semibold tracking-tight text-white"><%= @room.name.presence || "Room" %></h1>
    <% if @room.waiting? && @room.host?(current_user) && @pending_invite_url.present? %>
      <div class="mt-3 rounded-lg border border-emerald-800/60 bg-emerald-950/40 p-3">
        <p class="text-xs font-medium uppercase tracking-wide text-emerald-200/90">Invite link</p>
        <div class="mt-2 flex flex-wrap items-stretch gap-2">
          <input
            type="text"
            readonly
            value="<%= @pending_invite_url %>"
            class="min-w-[12rem] flex-1 cursor-text rounded border border-slate-600 bg-slate-950 px-2 py-2 font-mono text-xs text-white outline-none focus:border-emerald-500 sm:text-sm"
            onclick="this.select()"
          >
          <button
            type="button"
            class="shrink-0 rounded-lg border border-emerald-600 bg-emerald-900/50 px-3 py-2 text-sm font-medium text-emerald-50 hover:bg-emerald-800/60"
            data-controller="clipboard"
            data-clipboard-text-value="<%= @pending_invite_url %>"
            data-action="clipboard#copy"
          >
            Copy
          </button>
        </div>
        <p class="mt-2 text-xs text-slate-500">Anyone with this link can join while the lobby is open.</p>
      </div>
    <% end %>
  </div>

  <%= render "rooms/shell", room: @room %>
  <p class="mt-6 text-center">
    <%= link_to "Round archive", archive_room_path(@room), class: "text-sm text-emerald-400 hover:text-emerald-300" %>
  </p>
</div>
